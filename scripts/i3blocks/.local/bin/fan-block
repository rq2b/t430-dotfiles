#!/bin/sh

HWMON="/sys/class/hwmon/hwmon3"
FAN="$HWMON/fan1_input"
PWM_ENABLE="$HWMON/pwm1_enable"
MIN_RPM=2573
MAX_RPM=5347
MISSING='FAN: --%'


if [ ! -r "$FAN" ] || [ ! -r "$PWM_ENABLE" ]; then
    printf '%s\n' "$MISSING"
    exit 0
fi

if ! IFS= read -r rpm < "$FAN"; then
    printf '%s\n' "$MISSING"
    exit 0
fi

if ! IFS= read -r pwm_enable < "$PWM_ENABLE"; then
    printf '%s\n' "$MISSING"
    exit 0
fi

case "$rpm" in
    ''|*[!0-9]*)
        printf '%s\n' "$MISSING"
        exit 0
        ;;
esac

case "$pwm_enable" in
    0|1|2) ;;
    *)
        printf '%s\n' "$MISSING"
        exit 0
        ;;
esac

if [ "${#rpm}" -gt 5 ]; then
    printf '%s\n' "$MISSING"
    exit 0
fi

if [ "$rpm" -eq 65535 ] && [ "$pwm_enable" -ne 0 ]; then
    printf '%s\n' "$MISSING"
    exit 0
fi

if [ "$rpm" -eq 0 ]; then
    percentage=0
elif [ "$pwm_enable" -eq 0 ]; then
    percentage=99
else
    [ "$rpm" -ge "$MIN_RPM" ] || rpm=$MIN_RPM
    [ "$rpm" -le "$MAX_RPM" ] || rpm=$MAX_RPM

    percentage=$((1 + (rpm - MIN_RPM) * 97 / (MAX_RPM - MIN_RPM)))
fi

printf 'FAN: %02d%%\n' "$percentage"