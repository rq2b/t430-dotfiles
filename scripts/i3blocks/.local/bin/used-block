#!/bin/sh

target="/"
label="SDA"

df -B1 --output=used,size "$target" 2>/dev/null |
awk -v label="$label" '
    NR == 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
        printf "USED: %.0fG / %.0fG @ %s\n",
            $1/1000000000, $2/1000000000, label
        found=1
    }
    END {
        if (!found) printf "USED: -.- / -.- @ %s\n", label
    }
'