#!/bin/sh

TARGET="/"
LABEL="SDA"
BYTES_PER_GB=1000000000


df -B1 --output=used,size "$TARGET" 2>/dev/null |
awk -v label="$LABEL" -v bytes_per_gb="$BYTES_PER_GB" '
    NR == 2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
        used_gb = int($1 / bytes_per_gb + 0.5)
        total_gb = int($2 / bytes_per_gb + 0.5)

        printf "%s: %.0fG / %dG\n", label, used_gb, total_gb
        found = 1
    }

    END {
        if (!found)
            printf "%s: ---G @ ---G\n", label
    }
'