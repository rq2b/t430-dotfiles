#!/bin/sh

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/i3blocks-network"
mkdir -p "$CACHE" || {
    echo "TX: --- KB/s"
    exit 0
}

iface=$(ip route show default 2>/dev/null | awk '
    NR == 1 {
        for (i = 1; i <= NF; i++)
            if ($i == "dev") { print $(i+1); exit }
    }
')

if [ -z "$iface" ] || [ ! -r "/sys/class/net/$iface/statistics/tx_bytes" ]; then
    echo "TX: --- KB/s"
    exit 0
fi

tx=$(cat "/sys/class/net/$iface/statistics/tx_bytes") || {
    echo "TX: --- KB/s"
    exit 0
}

case "$tx" in
    ''|*[!0-9]*)
        echo "TX: --- KB/s"
        exit 0
        ;;
esac

cache="$CACHE/tx"
now=$(date +%s%N)

if [ -r "$cache" ]; then
    read -r old_iface old_tx old_time < "$cache"

    case "$old_tx:$old_time" in
        *[!0-9:]*|:*|*:)
            old_iface=""
            ;;
    esac

    if [ "$old_iface" = "$iface" ] &&
       [ -n "$old_tx" ] &&
       [ -n "$old_time" ]; then

        elapsed=$((now - old_time))

        if [ "$elapsed" -gt 0 ] && [ "$tx" -ge "$old_tx" ]; then
            awk -v bytes="$((tx - old_tx))" -v elapsed="$elapsed" '
                BEGIN {
                    speed = bytes * 1000000000 / elapsed / 1000

                    if (speed >= 1000)
                        printf "TX: %03d MB/s\n", int(speed / 1000 + 0.5)
                    else
                        printf "TX: %03d KB/s\n", int(speed + 0.5)
                }
            '
        else
            echo "TX: --- KB/s"
        fi
    else
        echo "TX: --- KB/s"
    fi
else
    echo "TX: --- KB/s"
fi

printf '%s %s %s\n' "$iface" "$tx" "$now" > "$cache"
