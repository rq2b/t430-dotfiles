#!/bin/bash
set -u

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/i3blocks-network"
mkdir -p "$CACHE" || {
    echo "RX: --- KB/s"
    exit 0
}

iface=$(ip route show default 2>/dev/null | awk '
    NR == 1 {
        for (i = 1; i <= NF; i++)
            if ($i == "dev") { print $(i+1); exit }
    }
')

if [[ -z "$iface" || ! -r "/sys/class/net/$iface/statistics/rx_bytes" ]]; then
    echo "RX: --- KB/s"
    exit 0
fi

rx=$(cat "/sys/class/net/$iface/statistics/rx_bytes") || {
    echo "RX: --- KB/s"
    exit 0
}

cache="$CACHE/rx"
now=$(date +%s%N)

if [[ -r "$cache" ]]; then
    read -r old_iface old_rx old_time < "$cache" || true

    if [[ "${old_iface:-}" == "$iface" &&
          "${old_rx:-}" =~ ^[0-9]+$ &&
          "${old_time:-}" =~ ^[0-9]+$ ]]; then

        elapsed=$((now - old_time))

        if (( elapsed > 0 && rx >= old_rx )); then
            awk -v bytes="$((rx - old_rx))" \
                -v elapsed="$elapsed" '
                BEGIN {
                    speed = bytes * 1000000000 / elapsed / 1000

                    if (speed >= 1000)
                        printf "RX: %03d MB/s\n", int(speed / 1000 + 0.5)
                    else
                        printf "RX: %03d KB/s\n", int(speed + 0.5)
                }
            '
        else
            echo "RX: --- KB/s"
        fi
    else
        echo "RX: --- KB/s"
    fi
else
    echo "RX: --- KB/s"
fi

printf '%s %s %s\n' "$iface" "$rx" "$now" > "$cache"
