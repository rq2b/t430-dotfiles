#!/bin/sh

volume=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null |
    awk 'NR == 1 {
        for (i = 1; i <= NF; i++)
            if ($i ~ /^[0-9]+%$/) {
                gsub(/%/, "", $i)
                print $i
                exit
            }
    }')

case "$volume" in
    ''|*[!0-9]*)
        printf 'VOL: --%%\n'
        ;;
    *)
        printf 'VOL: %s%%\n' "$volume"
        ;;
esac